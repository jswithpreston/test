# ─── Database ────────────────────────────────────────────────────────────────
# Supabase: Settings → Database → Connection string (URI mode)
# Local: postgresql://postgres:password@localhost:5432/lci
DATABASE_URL=postgresql://user:password@host:5432/lci

# ─── Payload CMS ─────────────────────────────────────────────────────────────
# Random secret used for JWT signing — min 32 characters
# Generate one: openssl rand -base64 32
PAYLOAD_SECRET=your-secret-key-min-32-chars-here

# ─── App URL ─────────────────────────────────────────────────────────────────
# Development
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Production (set in Vercel env vars)
# NEXT_PUBLIC_SERVER_URL=https://lcf.or.ug

# ─── Cloudinary (future — for production media storage) ──────────────────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
